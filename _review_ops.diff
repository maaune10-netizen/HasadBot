+
+        return (True, f"✅ تم ترقية <code>{target_uid}</code> إلى أدمن مع اشتراك شهري.")
+    except Exception as e:
+        logger.error(f"add_admin error: {e}")
+        return (False, f"❌ فشل: {e}")
